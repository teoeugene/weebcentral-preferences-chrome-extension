{
  "manifest_version": 3,
  "name": "WeebCentral Preferences",
  "version": "0.1.0",
  "description": "Reading-style defaults by series type, with remembered per-series overrides.",
  "permissions": ["storage"],
  "host_permissions": ["https://weebcentral.com/*", "https://www.weebcentral.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "WeebCentral Preferences", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": [
      "https://weebcentral.com/chapters/*", "https://weebcentral.com/series/*",
      "https://www.weebcentral.com/chapters/*", "https://www.weebcentral.com/series/*"
    ],
    "js": ["core.js", "reader-dom.js", "content.js"],
    "run_at": "document_idle"
  }]
}
